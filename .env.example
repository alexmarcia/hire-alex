# Copy to .env.local for local dev. On Vercel, add these in Project Settings > Environment Variables.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-5. Use claude-haiku-4-5 for lowest cost.
ANTHROPIC_MODEL=claude-sonnet-5
# Optional but recommended: enables vector search (RAG with embeddings). Free tier at voyageai.com.
# Without it the app falls back to BM25 keyword retrieval automatically.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
